{
  "name": "@tehw0lf/yaft-playground",
  "version": "0.1.3",
  "description": "Proves @tehw0lf/yaft works against a running YaFT backend, not just against mocks.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "nx serve yaft-playground",
    "build": "nx build yaft-playground",
    "lint": "eslint src e2e/src",
    "test": "jest --passWithNoTests",
    "e2e": "cd e2e && playwright test --project=chromium",
    "backend:up": "./scripts/backend.sh up",
    "backend:down": "./scripts/backend.sh down",
    "backend:seed": "./scripts/seed.sh",
    "prestart": "node -e \"const fs=require('fs');const p='src/environments/seed.json';if(!fs.existsSync(p))fs.copyFileSync('src/environments/seed.example.json',p)\"",
    "prebuild": "node -e \"const fs=require('fs');const p='src/environments/seed.json';if(!fs.existsSync(p))fs.copyFileSync('src/environments/seed.example.json',p)\"",
    "pretest": "node -e \"const fs=require('fs');const p='src/environments/seed.json';if(!fs.existsSync(p))fs.copyFileSync('src/environments/seed.example.json',p)\""
  },
  "dependencies": {
    "@angular/common": "22.1.5",
    "@angular/compiler": "22.1.5",
    "@angular/core": "22.1.5",
    "@angular/forms": "22.1.5",
    "@angular/platform-browser": "22.1.5",
    "@angular/platform-browser-dynamic": "22.1.5",
    "@angular/router": "22.1.5",
    "@tehw0lf/yaft": "0.0.16",
    "rxjs": "7.8.2",
    "zone.js": "0.16.3",
    "axios": "1.18.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.1.7",
    "@angular-devkit/schematics": "22.1.7",
    "@angular/build": "22.1.7",
    "@angular/cli": "22.1.7",
    "@angular/compiler-cli": "22.1.5",
    "@angular/language-service": "22.1.5",
    "@eslint/js": "10.0.1",
    "@nx/angular": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/jest": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/playwright": "23.2.1",
    "@nx/web": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@playwright/test": "1.61.0",
    "@schematics/angular": "22.1.7",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.41",
    "@swc/helpers": "0.5.23",
    "@types/jest": "30.0.0",
    "@types/node": "24.1.0",
    "@typescript-eslint/utils": "8.61.1",
    "angular-eslint": "22.5.0",
    "eslint": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.10.4",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-preset-angular": "17.0.0",
    "jest-util": "30.4.1",
    "nx": "23.2.1",
    "prettier": "3.8.4",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.2",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1"
  }
}
